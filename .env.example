# Copy to .env and fill in. .env is ignored by git: never commit keys.

# Claude, for the AI reading (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
# Financial Modeling Prep (https://site.financialmodelingprep.com/developer/docs/dashboard)
FMP_API_KEY=
# The SEC asks for a contact in the User-Agent: "fundamentals-lab you@example.com"
SEC_USER_AGENT=

# Optional
# READING_MODEL=claude-opus-5-5
# READING_DAILY_MAX_USD=0.50
# READING_TOTAL_MAX_USD=5.00
