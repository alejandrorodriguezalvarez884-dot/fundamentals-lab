---
// Shell shared by every page. The tool is a section of Market Hub, so the header is the portal's
// own (logo, sections, search, account) with this tool's pages on a second line.
import Layout from "../layouts/Layout.astro";
import { AUTHOR_URL, HUB_URL, RADAR_URL, REPO_URL, SITE_NAME, link } from "../lib/site";
import HubBar from "./HubBar.astro";
import Search from "./Search.astro";

interface Props {
	title: string;
	description: string;
	wide?: boolean; // kept for the pages that passed it: every page has the portal's width now
}
const { title, description } = Astro.props;

const path = Astro.url.pathname;
const under = (...roots: string[]) => roots.some((r) => path.startsWith(link(r)));
const sections = [
	{ href: `${HUB_URL}/today/`, label: "Today", active: false },
	{ href: `${HUB_URL}/markets/`, label: "Markets", active: false },
	{ href: `${HUB_URL}/news/`, label: "News", active: false },
	{ href: link("/"), label: "Fundamentals", active: true },
	{ href: `${RADAR_URL}/`, label: "Earnings", active: false },
];
const pages = [
	{ href: link("/"), label: "Company", active: path === link("/") || under("/stock/") },
	{ href: link("/compare/"), label: "Compare", active: under("/compare/") },
	{ href: link("/method/"), label: "Method", active: under("/method/") },
];
---

<Layout title={title === SITE_NAME ? `${title} — Market Hub` : `${title} — ${SITE_NAME} — Market Hub`} description={description}>
	<header class="top-0 z-50 border-b border-line bg-page/95 backdrop-blur sm:sticky">
		<div class="mx-auto flex h-14 max-w-[1240px] items-center gap-4 px-5 lg:gap-8">
			<a href={`${HUB_URL}/`} class="flex flex-none items-center gap-2.5 whitespace-nowrap text-[15px] font-semibold tracking-tight text-ink-strong">
				<svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M4 2v16M4 10h8"></path><circle cx="14.5" cy="10" r="2.75" fill="currentColor" stroke="none"></circle>
				</svg>
				<span>Market Hub</span>
			</a>
			<nav class="hidden sm:block" aria-label="Market Hub">
				<ul class="flex items-center gap-5 text-sm">
					{sections.map((l) => (
						<li><a href={l.href} aria-current={l.active ? "true" : undefined}
							class:list={["border-b py-1 transition-colors hover:text-ink-strong", l.active ? "border-ink-strong text-ink-strong" : "border-transparent text-muted"]}>{l.label}</a></li>
					))}
				</ul>
			</nav>
			<div class="ml-auto hidden w-full max-w-sm md:block"><Search compact id="header-search" /></div>
			<button id="search-toggle" type="button" class="ml-auto rounded-sm p-2 text-muted hover:text-ink-strong md:hidden" aria-label="Search" aria-expanded="false" aria-controls="mobile-search">
				<svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="9" cy="9" r="6"></circle><path d="m14 14 4 4" stroke-linecap="round"></path></svg>
			</button>
			<HubBar />
		</div>
		<div id="mobile-search" class="border-t border-line px-5 py-2 md:hidden" hidden><Search compact id="mobile-search-box" /></div>
		<nav class="border-t border-line sm:hidden" aria-label="Market Hub">
			<ul class="flex gap-5 overflow-x-auto px-5 text-sm [scrollbar-width:none]">
				{sections.map((l) => (
					<li><a href={l.href} aria-current={l.active ? "true" : undefined}
						class:list={["-mb-px block border-b py-2", l.active ? "border-ink-strong text-ink-strong" : "border-transparent text-muted"]}>{l.label}</a></li>
				))}
			</ul>
		</nav>
		<nav class="border-t border-line" aria-label={SITE_NAME}>
			<ul class="mx-auto flex max-w-[1240px] items-center gap-5 overflow-x-auto px-5 text-sm [scrollbar-width:none]">
				<li class="hidden flex-none py-2 font-medium text-ink-strong sm:block">{SITE_NAME}</li>
				{pages.map((l) => (
					<li class="flex-none"><a href={l.href} aria-current={l.active ? "page" : undefined}
						class:list={["block py-2 transition-colors hover:text-ink-strong", l.active ? "text-ink-strong underline decoration-1 underline-offset-[6px]" : "text-muted"]}>{l.label}</a></li>
				))}
			</ul>
		</nav>
	</header>
	<main class="mx-auto max-w-[1240px] px-5 pb-24 pt-8 sm:pt-12">
		<slot />
	</main>
	<footer class="border-t border-line">
		<div class="mx-auto grid max-w-[1240px] gap-6 px-5 py-8 text-[13px] text-muted md:grid-cols-[1fr_auto]">
			<p class="max-w-2xl">
				Figures computed from company filings, market prices and the analysts' consensus as published by the data
				provider. Forward multiples are that consensus at today's price, not a forecast. Nothing here is investment
				advice or a recommendation to buy or sell anything. Data can be delayed or contain errors.{" "}
				<a href={link("/method/")} class="link">Sources and formulas</a>.
			</p>
			<div class="flex flex-wrap items-start gap-x-5 gap-y-1">
				<a href={`${HUB_URL}/privacy/`} class="hover:text-ink-strong">Privacy</a>
				<a href={REPO_URL} class="hover:text-ink-strong">Source</a>
				<a href={AUTHOR_URL} class="hover:text-ink-strong">Built by Alejandro Rodríguez Álvarez</a>
			</div>
		</div>
	</footer>
</Layout>

<script>
	const toggle = document.getElementById("search-toggle")!;
	const box = document.getElementById("mobile-search")!;
	toggle.addEventListener("click", () => {
		box.hidden = !box.hidden;
		toggle.setAttribute("aria-expanded", String(!box.hidden));
		if (!box.hidden) box.querySelector("input")?.focus();
	});
	// "/" goes to the search from anywhere on the page.
	document.addEventListener("keydown", (e) => {
		if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
		if ((e.target as HTMLElement).closest("input, textarea, select, [contenteditable]")) return;
		const input = document.querySelector<HTMLInputElement>("#header-search input");
		if (!input || !input.offsetParent) return;
		e.preventDefault();
		input.focus();
	});
</script>
