---
// Shell shared by every page: header with the navigation, the page body and the footer.
import Layout from "../layouts/Layout.astro";
import { AUTHOR_URL, REPO_URL, SITE_NAME, link } from "../lib/site";

interface Props {
	title: string;
	description: string;
	wide?: boolean;
}
const { title, description, wide = false } = Astro.props;

const path = Astro.url.pathname;
const under = (...roots: string[]) => roots.some((r) => path.startsWith(link(r)));
const links = [
	{ href: link("/"), label: "Search", active: path === link("/") || under("/stock/") },
	{ href: link("/compare/"), label: "Compare", active: under("/compare/") },
	{ href: link("/method/"), label: "Method", active: under("/method/") },
];
const width = wide ? "max-w-6xl" : "max-w-5xl";
---

<Layout title={title === SITE_NAME ? title : `${title} — ${SITE_NAME}`} description={description}>
	<header class="sticky top-0 z-50 border-b border-stone-200/80 bg-stone-50/85 backdrop-blur">
		<nav class={`mx-auto flex ${width} items-center justify-between gap-4 px-4 py-3 sm:px-6`}>
			<a href={link("/")} class="flex flex-none items-center gap-2 whitespace-nowrap font-serif text-base font-semibold tracking-tight text-stone-900 sm:text-lg">
				<img src={link("/favicon.svg")} alt="" class="h-6 w-6" />{SITE_NAME}
			</a>
			<ul class="flex items-center gap-0.5 text-sm sm:gap-1">
				{
					links.map((l) => (
						<li>
							<a
								href={l.href}
								aria-current={l.active ? "page" : undefined}
								class={`whitespace-nowrap rounded-full px-2.5 py-1.5 sm:px-3 transition-colors hover:text-stone-900 ${l.active ? "bg-stone-200/70 font-medium text-stone-900" : "text-stone-600"}`}
							>
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</header>
	<main class={`mx-auto ${width} px-4 pb-20 pt-8 sm:px-6 sm:pt-12`}>
		<slot />
		<p class="mt-16 border-t border-stone-200 pt-6 text-xs leading-relaxed text-stone-500">
			Figures computed from company filings, market prices and the analysts' consensus as published by the data
			provider. Forward multiples are that consensus at today's price, not a forecast. Nothing on this site is
			investment advice or a recommendation to buy or sell any security. Data may be delayed or contain errors.{" "}
			<a href={link("/method/")} class="underline hover:text-stone-900">Sources and formulas</a>.
		</p>
	</main>
	<footer class="border-t border-stone-200">
		<div class={`mx-auto ${width} px-4 py-8 text-center text-sm text-stone-400 sm:px-6`}>
			Built by <a href={AUTHOR_URL} class="underline hover:text-stone-700">Alejandro Rodríguez Álvarez</a> ·{" "}
			<a href={REPO_URL} class="underline hover:text-stone-700">Source on GitHub</a>
		</div>
	</footer>
</Layout>

<style is:global>
	.font-serif {
		font-family: "Source Serif 4", Georgia, serif;
	}
	.chart-tip {
		position: absolute;
		top: 0;
		transform: translate(-50%, -8px);
		min-width: 140px;
		padding: 8px 10px;
		border-radius: 10px;
		border: 1px solid #e7e5e4;
		background: #fff;
		box-shadow: 0 8px 24px rgba(28, 25, 23, 0.12);
		font-size: 12px;
		pointer-events: none;
		z-index: 10;
	}
	.chart-tip[hidden] {
		display: none;
	}
	.range-btn,
	.tab-btn {
		border-radius: 9999px;
		padding: 4px 10px;
		font-size: 12px;
		font-weight: 500;
		color: #57534e;
		transition: background 0.15s;
	}
	.range-btn:hover,
	.tab-btn:hover {
		background: #f5f5f4;
	}
	.range-btn[aria-pressed="true"],
	.tab-btn[aria-selected="true"] {
		background: #1c1917;
		color: #fff;
	}
	.data-table {
		width: 100%;
		font-size: 13px;
		font-variant-numeric: tabular-nums;
	}
	.data-table th,
	.data-table td {
		padding: 6px 10px;
		white-space: nowrap;
		text-align: right;
	}
	.data-table th:first-child,
	.data-table td:first-child {
		text-align: left;
		position: sticky;
		left: 0;
		background: #fff;
	}
	.data-table thead th {
		font-weight: 500;
		color: #78716c;
		border-bottom: 1px solid #e7e5e4;
	}
	.data-table tbody tr + tr td {
		border-top: 1px solid #f5f5f4;
	}
	.data-table td.group {
		padding-top: 14px;
		font-size: 11px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: #a8a29e;
	}
</style>
