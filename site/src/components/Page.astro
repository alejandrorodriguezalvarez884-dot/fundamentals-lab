---
// Shell shared by every page: header with the navigation, the page body and the footer.
import Layout from "../layouts/Layout.astro";
import { AUTHOR_URL, REPO_URL, SITE_NAME, link } from "../lib/site";
import HubBar from "./HubBar.astro";

interface Props {
	title: string;
	description: string;
	wide?: boolean;
}
const { title, description, wide = false } = Astro.props;

const path = Astro.url.pathname;
const under = (...roots: string[]) => roots.some((r) => path.startsWith(link(r)));
const links = [
	{ href: link("/"), label: "Search", active: path === link("/") || under("/stock/") },
	{ href: link("/compare/"), label: "Compare", active: under("/compare/") },
	{ href: link("/method/"), label: "Method", active: under("/method/") },
];
const width = wide ? "max-w-[1280px]" : "max-w-6xl";
---

<Layout title={title === SITE_NAME ? title : `${title} — ${SITE_NAME}`} description={description}>
	<header class="sticky top-0 z-50 border-b border-line bg-page/95 backdrop-blur">
		<nav class={`mx-auto flex h-14 ${width} items-center gap-3 px-4 sm:gap-6`}>
			<a href={link("/")} class="flex flex-none items-center gap-2 whitespace-nowrap text-[15px] font-bold tracking-tight text-ink-strong">
				<img src={link("/favicon.svg")} alt="" class="h-7 w-7" /><span class="hidden sm:inline">{SITE_NAME}</span>
			</a>
			<ul class="flex items-center gap-0.5 text-[13px] font-semibold sm:gap-1">
				{
					links.map((l) => (
						<li>
							<a
								href={l.href}
								aria-current={l.active ? "page" : undefined}
								class={`whitespace-nowrap rounded px-2.5 py-2 transition-colors hover:bg-raised hover:text-ink-strong sm:px-3 ${l.active ? "text-ink-strong" : "text-muted"}`}
							>
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
			<div class="ml-auto"><HubBar /></div>
		</nav>
	</header>
	<main class={`mx-auto ${width} px-4 pb-16 pt-6 sm:pt-8`}>
		<slot />
		<p class="mt-14 border-t border-line pt-5 text-xs leading-relaxed text-muted">
			Figures computed from company filings, market prices and the analysts' consensus as published by the data
			provider. Forward multiples are that consensus at today's price, not a forecast. Nothing on this site is
			investment advice or a recommendation to buy or sell any security. Data may be delayed or contain errors.{" "}
			<a href={link("/method/")} class="underline hover:text-ink-strong">Sources and formulas</a>.
		</p>
	</main>
	<footer class="border-t border-line bg-deep">
		<div class={`mx-auto ${width} flex flex-wrap justify-center gap-x-4 gap-y-1 px-4 py-8 text-xs text-muted`}>
			<span>Part of Market Hub</span>
			<a href={AUTHOR_URL} class="hover:text-ink">Built by Alejandro Rodríguez Álvarez</a>
			<a href={REPO_URL} class="hover:text-ink">Source on GitHub</a>
		</div>
	</footer>
</Layout>
