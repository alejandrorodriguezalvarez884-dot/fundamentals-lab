---
// The comparison: two to five companies side by side.
import Page from "../components/Page.astro";
import Search from "../components/Search.astro";
---

<Page title="Compare" description="Compare up to five US-listed companies: fundamentals, valuation, forward multiples and price performance side by side." wide>
	<h1 class="text-[2rem] font-medium leading-tight tracking-tight text-ink-strong">Compare companies</h1>
	<p class="mt-2 text-ink">Add two to five companies by name or ticker.</p>
	<div class="mt-5 flex flex-col gap-3 lg:flex-row lg:items-start">
		<div class="w-full max-w-md"><Search mode="pick" button="Add" id="pick" /></div>
		<div id="chips" class="flex flex-wrap gap-2 lg:pt-2"></div>
	</div>
	<div id="suggest" class="mt-3 flex flex-wrap items-center gap-2 empty:hidden"></div>
	<div id="compare" class="mt-12"></div>
</Page>

<script>
	import { scatter, SERIES } from "../lib/charts";
	import { add, card, h } from "../lib/dom";
	import { fmt, type Kind } from "../lib/format";
	import { compareChart } from "../lib/pricechart";
	import { API, compareUrl, stockUrl, tidyName } from "../lib/site";
	import { renderReading } from "../lib/stockview";
	import type { Comparison, PeerDetail, Reading } from "../lib/types";

	const MAX = 5;
	const root = document.getElementById("compare")!;
	const suggest = document.getElementById("suggest")!;
	const chips = document.getElementById("chips")!;
	const form = document.getElementById("pick")!;
	let tickers = (new URLSearchParams(location.search).get("t") ?? "").split(",").map((t) => t.trim().toUpperCase()).filter(Boolean).slice(0, MAX);
	tickers = [...new Set(tickers)];

	const KIND: Record<string, Kind> = {
		market_cap: "money", "forward.peg": "num", "technical.beta_1y": "num",
	};
	const kindOf = (key: string): Kind => KIND[key] ?? (/(^valuation\.(pe|ev_|p_))|forward\.years\.0\.pe|net_debt_to_ebitda/.test(key) ? "mult" : /technical\.return|cagr|growth|drawdown/.test(key) ? "spct" : "pct");

	function drawChips() {
		chips.replaceChildren(...tickers.map((t, k) => {
			const chip = h("span", "num inline-flex items-center gap-2 rounded-[3px] border border-line-strong py-1 pl-2.5 pr-1 text-[13px] text-ink-strong");
			const dot = h("span", "inline-block h-2.5 w-2.5 rounded-full");
			dot.style.background = SERIES[k];
			const x = h("button", "rounded-sm px-1.5 text-muted hover:bg-raised hover:text-ink-strong", "×");
			x.type = "button";
			x.setAttribute("aria-label", `Remove ${t}`);
			x.addEventListener("click", () => setTickers(tickers.filter((u) => u !== t)));
			return add(chip, dot, t, x);
		}));
		drawSuggestions();
	}

	// One press adds a company whose business description reads like the first one's (the peer map).
	let asked = 0;
	async function drawSuggestions() {
		const mine = ++asked;
		suggest.replaceChildren();
		if (!tickers.length || tickers.length >= MAX) return;
		try {
			const res = await fetch(`${API}/api/peers/${encodeURIComponent(tickers[0])}`);
			if (!res.ok) return;
			const found = (await res.json()) as PeerDetail;
			const more = found.peers.filter((p) => !tickers.includes(p.ticker)).slice(0, 6);
			if (mine !== asked || !more.length) return;
			suggest.append(h("span", "text-[13px] text-muted", `Similar businesses to ${found.ticker}`), ...more.map((p) => {
				const b = h("button", "chip py-0.5 hover:border-muted hover:text-ink-strong", `+ ${p.ticker}`);
				b.type = "button";
				b.title = tidyName(p.name);
				b.addEventListener("click", () => setTickers([...tickers, p.ticker]));
				return b;
			}));
		} catch {
			// Without the map the comparison works as before.
		}
	}

	function setTickers(next: string[]) {
		tickers = next;
		history.replaceState(null, "", tickers.length ? compareUrl(tickers) : location.pathname);
		drawChips();
		load();
	}

	form.addEventListener("pick", (e) => {
		const t = (e as CustomEvent<{ ticker: string }>).detail.ticker.toUpperCase();
		if (tickers.includes(t)) return;
		if (tickers.length >= MAX) return alert(`Up to ${MAX} companies.`);
		setTickers([...tickers, t]);
	});

	function readingCard(): HTMLElement {
		const c = card("AI reading of the comparison", "Claude compares the numbers in the table. It names highest and lowest; it does not pick a winner.");
		const button = h("button", "btn btn-primary", "Write the reading");
		button.type = "button";
		const status = h("p", "mt-2 text-sm text-muted");
		c.body.append(add(h("div"), button, status));
		const go = async (spend: boolean) => {
			button.disabled = true;
			if (spend) status.textContent = "Reading the comparison… (about 20 seconds)";
			try {
				const res = await fetch(`${API}/api/compare/reading?tickers=${tickers.join(",")}${spend ? "" : "&cached_only=1"}`);
				if (res.status === 204) return void (button.disabled = false);
				const body = await res.json();
				if (!res.ok) throw new Error(body.detail ?? "The reading failed.");
				renderReading(c.body, body as Reading);
			} catch (e) {
				button.disabled = false;
				status.textContent = e instanceof Error ? e.message : "The reading failed.";
			}
		};
		button.addEventListener("click", () => go(true));
		go(false);
		return c.el;
	}

	function draw(r: Comparison) {
		const el = h("div", "grid min-w-0 gap-12");
		const perf = card("Price, rebased to 100", `Last year of daily closes, from ${r.prices.dates[0] ?? "—"}`);
		perf.body.append(r.prices.dates.length ? compareChart(r.prices.dates, r.prices.series, r.tickers) : h("p", "text-sm text-muted", "No common price history."));

		const tableCard = card("Side by side", "Highest and lowest value in each row are marked ▲ and ▼; neither means better.");
		const t = h("table", "data-table");
		const head = add(h("tr"), h("th", "", ""), ...r.companies.map((c, k) => {
			const th = h("th", "");
			const a = h("a", "num inline-flex items-center gap-1.5 text-ink-strong hover:underline", c.ticker) as HTMLAnchorElement;
			a.href = stockUrl(c.ticker);
			const dot = h("span", "inline-block h-2 w-2 rounded-full");
			dot.style.background = SERIES[k];
			a.prepend(dot);
			return add(th, a, h("div", "max-w-[10rem] truncate text-[12px] font-normal text-muted", tidyName(c.name)));
		}));
		const body = h("tbody");
		for (const row of r.table) {
			const kind = kindOf(row.key);
			body.append(add(h("tr"), h("td", "text-ink", row.label), ...row.values.map((v) => {
				const mark = v != null && row.highest !== row.lowest ? (v === row.highest ? " ▲" : v === row.lowest ? " ▼" : "") : "";
				return add(h("td", "text-ink-strong", fmt(kind, v ?? null)), mark ? h("span", "ml-1 text-[10px] text-faint", mark.trim()) : "");
			})));
		}
		add(t, add(h("thead"), head), body);
		tableCard.body.append(add(h("div", "overflow-x-auto"), t));

		const sc = card("Growth against valuation", "Each company's next fiscal year P/E at today's price against the consensus EPS growth rate");
		sc.body.append(scatter(r.scatter.map((p, k) => ({ label: p.ticker, x: p.eps_cagr, y: p.pe_next, color: SERIES[k] })), "EPS CAGR (consensus)", "P/E next FY", "pct", "mult"));
		const sc2 = card("Past growth against sales multiple", "Revenue CAGR over five years against EV/Sales today");
		sc2.body.append(scatter(r.scatter.map((p, k) => ({ label: p.ticker, x: p.revenue_cagr_5y, y: p.ev_sales, color: SERIES[k] })), "Revenue CAGR 5y", "EV/Sales", "pct", "mult"));

		add(el, readingCard(), perf.el, tableCard.el, add(h("div", "grid min-w-0 gap-x-14 gap-y-12 lg:grid-cols-2"), sc.el, sc2.el));
		root.replaceChildren(el);
	}

	let seq = 0;
	async function load() {
		const mine = ++seq;
		if (tickers.length < 2) {
			root.replaceChildren(h("p", "text-muted", tickers.length ? "Add at least one more company." : "Start by adding a company."));
			return;
		}
		root.replaceChildren(h("p", "animate-pulse text-sm text-muted", `Building the reports for ${tickers.join(", ")}…`));
		try {
			const res = await fetch(`${API}/api/compare?tickers=${tickers.map(encodeURIComponent).join(",")}`);
			const body = await res.json();
			if (!res.ok) throw new Error(body.detail ?? "The comparison failed.");
			if (mine === seq) draw(body as Comparison);
		} catch (e) {
			if (mine === seq) root.replaceChildren(h("p", "border-l-2 border-down pl-4 text-down", e instanceof Error ? e.message : "The comparison failed."));
		}
	}

	drawChips();
	load();
</script>
