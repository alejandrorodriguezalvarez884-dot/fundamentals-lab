---
import Page from "../components/Page.astro";
import Search from "../components/Search.astro";
import { SITE_NAME, compareUrl, stockUrl } from "../lib/site";

const examples = [
	["AAPL", "Apple"],
	["MSFT", "Microsoft"],
	["NVDA", "Nvidia"],
	["KO", "Coca-Cola"],
	["JPM", "JPMorgan"],
	["COST", "Costco"],
];
const comparisons = [
	["MSFT", "GOOGL", "AMZN"],
	["KO", "PEP"],
	["NVDA", "AMD", "AVGO"],
	["V", "MA"],
];
const sections = [
	["Fundamentals", "Ten years of income statement, balance sheet and cash flow, plus the last twelve quarters. Margins, returns on capital, leverage and growth, computed the same way for every company."],
	["Valuation", "P/E, EV/EBITDA, EV/Sales, P/FCF and yields today, and each one at every past fiscal year end, so today's multiple sits against the company's own history."],
	["Forward multiples", "The analysts' consensus for the next fiscal years turned into the multiples the stock would trade at if it is met and the price does not move."],
	["Technical analysis", "Candles with the 50- and 200-day averages, Bollinger bands, RSI and MACD, swing levels, volatility, drawdown and beta against the S&P 500."],
	["Comparison", "Up to five companies side by side: the same table, rebased prices, and growth against valuation on one chart."],
	["AI reading", "Claude reads the computed numbers and writes what they show, in plain words. It only describes: no advice, no price targets."],
];
---

<Page title={SITE_NAME} description="The numbers of any US-listed company: fundamentals, valuation history, forward multiples from the analysts' consensus, technical analysis and side-by-side comparison, with an AI reading.">
	<section class="mx-auto max-w-3xl pt-6 text-center sm:pt-12">
		<h1 class="font-serif text-4xl font-semibold tracking-tight text-stone-900 sm:text-5xl">Every number of a company, in one place</h1>
		<p class="mx-auto mt-4 max-w-2xl text-lg text-stone-600">
			Fundamentals, valuation against its own history, where the multiples go if the analysts' consensus is met, the technical
			picture and a side-by-side comparison. With an AI reading that explains the numbers, never what to do with them.
		</p>
		<div class="mx-auto mt-8 max-w-2xl text-left">
			<Search large autofocus />
		</div>
		<div class="mt-5 flex flex-wrap justify-center gap-2 text-sm">
			{examples.map(([t, n]) => (
				<a href={stockUrl(t)} class="rounded-full border border-stone-200 bg-white px-3 py-1 text-stone-700 hover:border-stone-400">
					<span class="font-semibold">{t}</span> <span class="text-stone-500">{n}</span>
				</a>
			))}
		</div>
	</section>

	<section class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{sections.map(([title, text]) => (
			<div class="rounded-2xl border border-stone-200 bg-white p-5">
				<h2 class="font-serif text-lg font-semibold text-stone-900">{title}</h2>
				<p class="mt-2 text-sm leading-relaxed text-stone-600">{text}</p>
			</div>
		))}
	</section>

	<section class="mt-12 rounded-2xl border border-stone-200 bg-white p-6">
		<h2 class="font-serif text-xl font-semibold text-stone-900">Compare companies</h2>
		<p class="mt-1 text-sm text-stone-600">Pick two to five. A few to start with:</p>
		<div class="mt-4 flex flex-wrap gap-2 text-sm">
			{comparisons.map((ts) => (
				<a href={compareUrl(ts)} class="rounded-full border border-stone-200 px-3 py-1 font-medium text-stone-700 hover:border-stone-400">{ts.join(" · ")}</a>
			))}
		</div>
	</section>
</Page>
