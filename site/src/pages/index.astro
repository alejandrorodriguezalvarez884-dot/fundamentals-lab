---
import Page from "../components/Page.astro";
import Search from "../components/Search.astro";
import { SITE_NAME, compareUrl, stockUrl } from "../lib/site";

const examples = [
	["AAPL", "Apple"],
	["MSFT", "Microsoft"],
	["NVDA", "Nvidia"],
	["KO", "Coca-Cola"],
	["JPM", "JPMorgan"],
	["COST", "Costco"],
];
const comparisons = [
	["MSFT", "GOOGL", "AMZN"],
	["KO", "PEP"],
	["NVDA", "AMD", "AVGO"],
	["V", "MA"],
];
const sections = [
	["Fundamentals", "Income statement, balance sheet and cash flow by year and by quarter. Margins, returns on capital, leverage and growth, computed the same way for every company."],
	["Valuation", "P/E, EV/EBITDA, EV/Sales, P/FCF and yields today, and each one at every past fiscal year end, so today's multiple sits against the company's own history."],
	["Forward multiples", "The analysts' consensus for the next fiscal years turned into the multiples the stock would trade at if it is met and the price does not move."],
	["Technical analysis", "Candles with the 50- and 200-day averages, Bollinger bands, RSI and MACD, swing levels, volatility, drawdown and beta against the S&P 500."],
	["Comparison", "Up to five companies side by side: the same table, rebased prices, and growth against valuation on one chart."],
	["Peers", "The companies whose own description of their business, in their annual reports, reads most like this one's, and a map of all of them."],
	["AI reading", "Claude reads the computed numbers and writes what they show, in plain words. It only describes: no advice, no price targets."],
];
---

<Page title={SITE_NAME} description="The numbers of any US-listed company: fundamentals, valuation history, forward multiples from the analysts' consensus, technical analysis and side-by-side comparison, with an AI reading.">
	<section>
		<h1 class="lede">Every number of a company, on one page.</h1>
		<p class="mt-5 max-w-2xl text-ink">
			Its statements, its valuation against its own history, where the multiples go if the analysts' consensus is met, and
			the technical picture. An AI reading says what the numbers show, never what to do with them.
		</p>
		<div class="mt-8 max-w-2xl">
			<Search large autofocus />
		</div>
		<p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted">
			<span>Try</span>
			{examples.map(([t, n]) => (
				<a href={stockUrl(t)} class="link">{n} <span class="num text-[12.5px] text-muted">{t}</span></a>
			))}
		</p>
	</section>

	<div class="mt-16 grid gap-x-14 gap-y-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
		<section class="sec">
			<h2 class="sec-title">What a company page has</h2>
			<dl class="mt-2 divide-y divide-line">
				{sections.map(([title, text]) => (
					<div class="grid gap-x-6 gap-y-0.5 py-3 sm:grid-cols-[10rem_minmax(0,1fr)]"><dt class="text-ink-strong">{title}</dt><dd class="text-sm text-muted">{text}</dd></div>
				))}
			</dl>
		</section>
		<section class="sec self-start">
			<div class="sec-head"><h2 class="sec-title">Compare companies</h2><span class="sec-note">Two to five, side by side</span></div>
			<ul class="divide-y divide-line">
				{comparisons.map((ts) => (
					<li><a href={compareUrl(ts)} class="group flex items-baseline justify-between gap-4 py-3">
						<span class="num text-ink-strong group-hover:underline">{ts.join("  ·  ")}</span><span class="text-muted group-hover:text-ink-strong" aria-hidden="true">→</span></a></li>
				))}
			</ul>
		</section>
	</div>
</Page>
