---
// The stock page. The page is a shell: the browser asks the API for the report, shows each step
// while it is built and then draws the tabs.
import Page from "../components/Page.astro";
---

<Page title="Stock" description="Fundamentals, valuation, forward multiples and technical analysis of a US-listed company." wide>
	<div id="stock"></div>
	<noscript><p class="mt-6 text-sm text-muted">This page needs JavaScript.</p></noscript>
</Page>

<script>
	import { add, h } from "../lib/dom";
	import { API } from "../lib/site";
	import { fundamentals, header, meta, overview, technical, valuation } from "../lib/stockview";
	import type { Report, Step } from "../lib/types";

	const root = document.getElementById("stock")!;
	const ticker = (new URLSearchParams(location.search).get("t") ?? "").trim().toUpperCase();

	const TABS = [
		["overview", "Overview", overview],
		["fundamentals", "Fundamentals", fundamentals],
		["valuation", "Valuation & forward", valuation],
		["technical", "Technical", technical],
	] as const;

	function draw(r: Report) {
		document.title = `${r.ticker} · ${r.profile.name} — Fundamentals Lab`;
		const nav = h("div", "tabs mb-10 border-b border-line");
		nav.setAttribute("role", "tablist");
		const panel = h("div");
		const built = new Map<string, HTMLElement>();
		const show = (id: string) => {
			for (const b of nav.querySelectorAll("button")) b.setAttribute("aria-selected", String(b.dataset.tab === id));
			const entry = TABS.find((t) => t[0] === id) ?? TABS[0];
			// Each tab is built the first time it is opened: the charts need a visible box.
			if (!built.has(entry[0])) built.set(entry[0], entry[2](r));
			panel.replaceChildren(built.get(entry[0])!);
			history.replaceState(null, "", `#${entry[0]}`);
		};
		for (const [id, label] of TABS) {
			const b = h("button", "tab-btn -mb-px !py-2 !text-sm", label);
			b.type = "button";
			b.dataset.tab = id;
			b.setAttribute("role", "tab");
			b.addEventListener("click", () => show(id));
			nav.append(b);
		}
		root.replaceChildren(header(r), nav, panel, meta(r));
		show(location.hash.slice(1) || "overview");
	}

	function progress(): { el: HTMLElement; step: (s: Step) => void } {
		const el = h("div", "sec max-w-xl");
		const list = h("ol", "space-y-2 text-sm");
		add(el, h("p", "sec-title mb-3", `Building the report for ${ticker}`), list);
		let last: HTMLElement | null = null;
		return {
			el,
			step: (s) => {
				if (last) last.classList.replace("text-ink-strong", "text-muted"), last.querySelector(".dot")?.classList.replace("animate-pulse", "opacity-40");
				const li = add(h("li", "flex items-center gap-2 text-ink-strong"), h("span", "dot inline-block h-1.5 w-1.5 flex-none animate-pulse rounded-full bg-ink-strong"), "detail" in s && s.detail ? s.detail : s.step);
				list.append(li);
				last = li;
			},
		};
	}

	async function load() {
		if (!ticker) {
			root.replaceChildren(h("p", "text-muted", "Search for a company by its name or ticker, in the box above."));
			return;
		}
		const p = progress();
		root.replaceChildren(p.el);
		try {
			const res = await fetch(`${API}/api/stock/${encodeURIComponent(ticker)}/stream`);
			if (!res.ok || !res.body) {
				const body = await res.json().catch(() => ({}));
				throw new Error(body.detail ?? `The report failed (${res.status}).`);
			}
			const reader = res.body.getReader();
			const decoder = new TextDecoder();
			let buffer = "";
			for (;;) {
				const { value, done } = await reader.read();
				if (done) break;
				buffer += decoder.decode(value, { stream: true });
				let nl;
				while ((nl = buffer.indexOf("\n")) >= 0) {
					const line = buffer.slice(0, nl).trim();
					buffer = buffer.slice(nl + 1);
					if (!line) continue;
					const s = JSON.parse(line) as Step;
					if (s.step === "error") throw new Error((s as { detail: string }).detail);
					if (s.step === "done") return draw((s as { report: Report }).report);
					p.step(s);
				}
			}
			throw new Error("The report was cut off. Try again.");
		} catch (e) {
			root.replaceChildren(h("p", "border-l-2 border-down pl-4 text-down", e instanceof Error ? e.message : "The report failed."));
		}
	}
	load();
</script>
